{
  "name": "kimap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "dev": "node preview/dev.mjs",
    "check:worker-assets": "node scripts/check-worker-assets.mjs",
    "audit:discovery": "node scripts/audit-discovery-evidence.mjs",
    "audit:context": "node scripts/audit-context-evidence.mjs",
    "audit:political": "node scripts/audit-political-evidence.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint \"script.js\" \"content/**/*.js\" \"modules/**/*.js\" \"stores/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\" \"eslint.config.mjs\" \"preview/**/*.mjs\" \"checks/**/*.mjs\" \"worker/**/*.mjs\"",
    "lint:js:fix": "eslint \"script.js\" \"content/**/*.js\" \"modules/**/*.js\" \"stores/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\" \"eslint.config.mjs\" --fix",
    "lint:css": "stylelint \"style.css\" \"modules/**/*.css\"",
    "lint:css:fix": "stylelint \"style.css\" \"modules/**/*.css\" --fix",
    "format:check": "prettier --check \"script.js\" \"content/**/*.js\" \"modules/**/*.{js,css}\" \"stores/**/*.js\" \"*.{json,html,css,mjs}\"",
    "format": "prettier --write \"script.js\" \"content/**/*.js\" \"modules/**/*.{js,css}\" \"stores/**/*.js\" \"*.{json,html,css,mjs}\"",
    "test": "node --test",
    "check": "npm run build && npm run lint && npm test",
    "test:browser": "node checks/browser.mjs",
    "package:build": "npm run build && npm run worker:build",
    "package:check": "node checks/package.mjs && cd worker && cf workers versions create --prebuilt --dry-run",
    "worker:build": "cd worker && vite build"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@eslint/js": "^9.39.5",
    "cf": "1.0.0-beta.27",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "globals": "^17.3.0",
    "miniflare": "5.20261103.0-beta",
    "playwright": "1.64.1",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@picocss/pico": "2.1.1",
    "alpinejs": "^3.15.8",
    "d3": "7.9.0",
    "leaflet": "1.9.4"
  },
  "main": "script.js",
  "keywords": [],
  "author": "mattresspad and the KiMap contributors",
  "license": "MIT",
  "description": "Manifest-aware interactive map and world-state workspace for the Kenshi Wiki ecosystem",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattresspad/kimap.git"
  }
}
